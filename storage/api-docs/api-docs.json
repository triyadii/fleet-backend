                            "schema": {
                                "required": [
                                    "plate_number"
                                ],
                                "properties": {
                                    "plate_number": {
                                        "type": "string",
                                        "example": "B 1234 CD"
                                    },
                                    "user_uuid": {
                                        "description": "UUID of the assigned user (pengguna)",
                                        "type": "string",
                                        "example": "123e4567-e89b-12d3-a456-426614174000"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Vehicle created successfully"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
