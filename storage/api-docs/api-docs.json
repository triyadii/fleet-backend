                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "plate_number": {
                                        "type": "string",
                                        "example": "B 9999 XX"
                                    },
                                    "user_uuid": {
                                        "type": "string",
                                        "example": "123e4567-e89b-12d3-a456-426614174000"
